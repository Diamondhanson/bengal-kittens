# ── Supabase ─────────────────────────────────────────────────────────────
# Create a project at https://supabase.com/dashboard, then find these under
# Project Settings → API. See SETUP.md for the full walkthrough.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (Project Settings → API → service_role). Server-only, never
# exposed to the browser. Used by the admin dashboard for writes + storage upload.
SUPABASE_SERVICE_ROLE_KEY=

# ── Resend ───────────────────────────────────────────────────────────────
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address for notification emails. Until you verify your own domain
# in Resend, keep the default sandbox sender below.
RESEND_FROM_EMAIL=Bengal Kittens <onboarding@resend.dev>

# ── Admin ────────────────────────────────────────────────────────────────
# Where order + contact notifications are sent, and the only email allowed to
# log in to the dashboard.
ADMIN_EMAIL=bengalkittensavailable11@gmail.com

# Password for the PREVIEW-ONLY dashboard login. This login only works while
# Supabase is not configured. Once the Supabase keys above are filled in, the
# dashboard switches to real Supabase email/password auth and this is ignored.
ADMIN_PREVIEW_PASSWORD=preview
